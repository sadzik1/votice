# matches docker-compose.yml
DATABASE_URL="postgresql://survey:survey@localhost:5432/survey?schema=public"

# integration/e2e tests wipe this one
TEST_DATABASE_URL="postgresql://survey:survey@localhost:5432/survey_test?schema=public"

# only for `prisma migrate dev` against `npx prisma dev`
# SHADOW_DATABASE_URL=""

# direct connection for migrations when DATABASE_URL is pooled (neon "-pooler" host)
# DATABASE_URL_UNPOOLED=""

# set to 1 for `npx prisma dev`
# DATABASE_POOL_MAX=1

PORT=3000
